# ENVIRONMENT=production makes a missing SECRET_KEY a fatal startup error.
ENVIRONMENT=development
# User access-token signing key (required in production).
SECRET_KEY=
# Optional distinct signing domains; both fall back to SECRET_KEY.
SESSION_SECRET=
DEVICE_SECRET=
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=
OPENAI_API_KEY=
MODEL_NAME=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_EMAIL_REDIRECT_URL=https://portal-three-rho.vercel.app/auth?verified=1

# Supabase project budgets — the deployment-wide ceilings enforced against
# the project's quota (defaults target a *free* project: 1 GB Storage,
# ~5 GB/mo egress, 500 MB database). Raise all three together if the
# Supabase plan is upgraded.
SUPABASE_PROJECT_STORAGE_BYTES=1073741824
SUPABASE_MONTHLY_EGRESS_BUDGET_BYTES=4294967296
SUPABASE_DB_BUDGET_BYTES=482344960

# Time-series retention — bounds append-only telemetry tables so the DB
# stays inside SUPABASE_DB_BUDGET_BYTES. Values in days; 0 disables.
TS_RETENTION_CONTEXT_EVIDENCE_DAYS=30
TS_RETENTION_CONTEXT_EVENT_DAYS=30
TS_RETENTION_NODE_EVENT_DAYS=14
TS_RETENTION_BATCH_ROWS=20000
TS_RETENTION_JOB_SECONDS=3600

# Device presence freshness window (seconds).
DEVICE_ONLINE_TIMEOUT_SECONDS=90

# Stripe values must come from deployment secrets/configuration. Prices and
# discounts are created in Stripe; the application stores identifiers only.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/settings
STRIPE_HARDWARE_PRODUCT_ID=
STRIPE_HARDWARE_PRICE_ID=
STRIPE_PRICE_ID_HOME_MONTHLY=
STRIPE_PRICE_ID_HOME_ANNUAL=
STRIPE_PRICE_ID_RESEARCH_MONTHLY=
STRIPE_PRICE_ID_RESEARCH_ANNUAL=
STRIPE_SHIPPING_RATE_IDS=
STRIPE_ALLOWED_SHIPPING_COUNTRIES=CA,US
